{
  "WorkingDirectory": "Y:\\IsoBuild\\Customize",
  "InputDirectory": "Y:\\Images\\Standard",
  "OutputDirectory": "Y:\\Images\\Customized",
  "LogDirectory": "Y:\\IsoBuild\\Logs",
  "RecoveryWimPath": "",
  "PostinstallSource": "",
  "BuildPostinstallIso": true,
  "PostinstallFolder": "Y:\\Images\\Customized\\postinstall",
  "KeepPrevious": true,
  "BuildIndex": true,
  "DeleteSourceAfterBuild": false,
  "DriverSets": [
    {
      "Name": "VirtIO",
      "Type": "virtio-iso",
      "Path": "Y:\\IsoBuild\\Cache\\virtio-win.iso",
      "Drivers": ["vioscsi", "viostor", "NetKVM"],
      "Targets": ["boot", "install", "winre"]
    },
    {
      "Name": "Storage",
      "Type": "folder",
      "Path": "Y:\\IsoBuild\\Drivers\\Storage",
      "Targets": ["boot", "install", "winre"],
      "Enabled": false
    }
  ],
  "Office": {
    "Enabled": true,
    "CacheDirectory": "Y:\\IsoBuild\\Cache\\office"
  },
  "Defender": {
    "Url": "https://go.microsoft.com/fwlink/?linkid=2144531",
    "CacheDirectory": "Y:\\IsoBuild\\Cache\\defender",
    "RebuildOnSignatureUpdate": false
  },
  "WinGet": {
    "Repository": "microsoft/winget-cli",
    "CacheDirectory": "Y:\\IsoBuild\\Cache\\winget"
  },
  "LogRetentionDays": 90
}
